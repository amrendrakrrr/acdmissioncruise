generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id         Int      @id @default(autoincrement())
  name       String
  email      String
  phone      String
  course     String
  message    String?
  status     String   @default("New")
  counsellor String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}